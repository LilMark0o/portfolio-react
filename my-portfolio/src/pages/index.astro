---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Project from "../components/Project.astro";
import projects from "../data/projects.json";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Marco Ramírez — Founding Software Engineer at Helios (YC W23). Full-stack products, from architecture to UI."
    />
    <link rel="icon" href="/images/briefcase-fill.svg" type="image/x-icon" />
    <title>Marco Ramírez — Software Engineer</title>
  </head>

  <body class="bg-bg font-body text-text">
    <Header />
    <Hero />
    <Experience />
    <Skills />

    <section id="projects" class="py-14 md:py-18">
      <div class="mx-auto max-w-[1180px] px-6 md:px-12">
        <div class="mb-3 text-[13px] font-bold uppercase tracking-[0.08em] text-accent">Selected Work</div>
        <h2 class="mb-10 font-display text-2xl font-bold md:mb-12 md:text-[32px]">Things I've built</h2>

        <div class="grid grid-cols-1 gap-7 md:grid-cols-2">
          {projects.map((project) => <Project {...project} />)}
        </div>
      </div>
    </section>
  </body>
</html>
