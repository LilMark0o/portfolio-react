---
import experience from "../data/experience.json";
---

<section id="experience" class="py-14 md:py-18">
  <div class="mx-auto max-w-[1180px] px-6 md:px-12">
    <div class="mb-3 text-[13px] font-bold uppercase tracking-[0.08em] text-accent">Experience</div>
    <h2 class="mb-10 font-display text-2xl font-bold md:mb-12 md:text-[32px]">Where I've worked</h2>

    <div class="flex flex-col">
      {
        experience.map((entry, i) => (
          <div class="flex gap-7">
            <div class="flex w-5 flex-shrink-0 flex-col items-center">
              {entry.current ? (
                <span class="mt-1 h-3.5 w-3.5 flex-shrink-0 rounded-full bg-text" />
              ) : (
                <span class="mt-[5px] h-3 w-3 flex-shrink-0 rounded-full border-2 border-text-faint bg-surface" />
              )}
              {i < experience.length - 1 && <span class="mt-1.5 w-0.5 flex-1 bg-border" />}
            </div>
            <div class={i < experience.length - 1 ? "pb-11" : ""}>
              <div class="mb-1 flex flex-wrap items-baseline gap-2.5">
                <h3 class="font-display text-lg font-bold">{entry.role}</h3>
                <span class="text-[15px] text-text-faint">— {entry.company}</span>
              </div>
              <p class="mb-3.5 text-sm font-semibold text-text-faint">{entry.dates}</p>
              <ul class="list-disc space-y-1.5 pl-[18px] text-[15.5px] leading-relaxed text-text-muted">
                {entry.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
