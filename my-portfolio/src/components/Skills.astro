---
import skillGroups from "../data/skills.json";
---

<section id="skills" class="border-y border-border bg-surface py-14 md:py-18">
  <div class="mx-auto max-w-[1180px] px-6 md:px-12">
    <div class="mb-3 text-[13px] font-bold uppercase tracking-[0.08em] text-accent">Skills</div>
    <h2 class="mb-10 font-display text-2xl font-bold md:text-[32px]">What I work with</h2>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 md:gap-6">
      {
        skillGroups.map((group) => (
          <div>
            <p class="mb-3.5 text-[13px] font-bold uppercase tracking-[0.05em] text-text-faint">
              {group.category}
            </p>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="inline-flex items-center rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
