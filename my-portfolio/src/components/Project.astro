---
export interface Props {
  title: string;
  description: string;
  image: string | null;
  tag?: string;
  note?: string;
  links?: Array<{ link: string; link_text: string }>;
}
const { title, description, image, tag, note, links = [] } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-border bg-surface">
  {
    image ? (
      <img src={image} alt={title} class="h-[200px] w-full object-cover" />
    ) : (
      <div class="flex h-[200px] w-full items-center justify-center bg-accent/90">
        <span class="font-display text-3xl font-extrabold tracking-tight text-white">
          {title}
        </span>
      </div>
    )
  }
  <div class="p-6">
    <div class="mb-2.5 flex items-center gap-2.5">
      <h3 class="font-display text-lg font-bold">{title}</h3>
      {
        tag && (
          <span class="inline-flex items-center rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs font-medium">
            {tag}
          </span>
        )
      }
    </div>
    <p class="mb-4 text-[15px] leading-relaxed text-text-muted">{description}</p>
    {
      note && (
        <p class="mb-4 text-sm font-medium text-text-faint">{note}</p>
      )
    }
    {
      links.length > 0 && (
        <div class="flex flex-wrap gap-5">
          {links.map((item) => (
            <a href={item.link} target="_blank" rel="noreferrer" class="link-arrow">
              {item.link_text}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7" /><path d="M7 7h10v10" />
              </svg>
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
